{
  "name": "inboxpilot-demo",
  "version": "1.0.0",
  "description": "InboxPilot concept product demo video (Remotion)",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "@remotion/fonts": "4.0.534",
    "@remotion/media": "4.0.534",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.534",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.39.5",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src && tsc --noEmit",
    "audio": "node scripts/generate-audio.mjs",
    "render:preview": "remotion render ProductDemo out/inboxpilot-demo-preview.mp4 --scale=0.5 --codec=h264",
    "render": "remotion render ProductDemo out/inboxpilot-demo.mp4 --codec=h264",
    "still": "remotion still ApprovedOrderStill out/approved-order.png",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "render:alcohol": "remotion render AlcoholExplainer out/alcohol-explainer.mp4 --codec=h264",
    "music:alcohol": "node scripts/generate-explainer-music.mjs"
  }
}
